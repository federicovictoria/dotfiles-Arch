[global]
    # Monitor y Posición
    monitor = 0
    follow = mouse
    geometry = "360x6-20+50"
    origin = top-right
    offset = 20x50
    notification_limit = 5

    # Apariencia Visual
    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300

    indicate_hidden = yes

    # Transparencia: 30% de transparencia (0.7 de opacidad)
    transparency = 30

    separator_height = 2
    padding = 16
    horizontal_padding = 18
    text_icon_padding = 12
    frame_width = 2
    
    # Bordes redondeados integrados
    corner_radius = 12

    # Colores base (Cian Neón / Azul Neón del fondo de Arch)
    frame_color = "#00f0ff"
    separator_color = "frame"

    # Tipografía y Formato
    font = Inter 12
    line_height = 4
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    # Iconos
    icon_position = left
    min_icon_size = 32
    max_icon_size = 48
    icon_path = /usr/share/icons/Papirus-Dark/16x16/status/:/usr/share/icons/Papirus-Dark/16x16/devices/

    # Interacción con Ratón (Clic para abrir/enfocar aplicación Flatpak o nativa)
    mouse_left_click = action, close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_current

    # Historia
    sticky_history = yes
    history_length = 20

    # Misceláneos
    dmenu = /usr/bin/rofi -dmenu -p dunst:
    browser = /usr/bin/xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst

#================================>
# NIVELES DE URGENCIA / COLORES (Futurista / Cian)
#================================>

[urgency_low]
    # Negro azulado profundo con texto blanco nítido y borde azul cian suave
    background = "#050b14"
    foreground = "#ffffff"
    frame_color = "#0077b6"
    timeout = 5

[urgency_normal]
    # Fondo obscuro con brillo cian neón en los bordes
    background = "#07101e"
    foreground = "#ffffff"
    frame_color = "#00f0ff"
    timeout = 8

[urgency_critical]
    # Magenta neón/Rojo para alertas importantes
    background = "#14050b"
    foreground = "#ffffff"
    frame_color = "#ff0055"
    timeout = 0

#================================>
# REGLAS PARA FLATPAKS Y REDES
#================================>

[flatpak_apps]
    desktop_entry = "^org\.telegram\.desktop|^com\.discordapp\.Discord|^org\.mozilla\.firefox|^com\.brave\.Browser"
    script = ""